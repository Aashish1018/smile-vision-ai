 "components": {
  "schemas": {
   "Body_create_scan_api_scans_post": {
    "properties": {
     "image": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "Image"
     },
     "clinic": {
      "type": "string",
      "title": "Clinic"
     }
    },
    "type": "object",
    "required": [
     "image",
     "clinic"
    ],
    "title": "Body_create_scan_api_scans_post"
   },
   "Category": {
    "type": "string",
    "enum": [
     "discoloration",
     "misalignment",
     "crowding",
     "spacing",
     "chipped_or_worn",
     "missing_tooth",
     "gum_inflammation",
     "gum_recession",
     "plaque_or_calculus",
     "visible_decay",
     "soft_tissue_lesion"
    ],
    "title": "Category"
   },
   "ChatIn": {
    "properties": {
     "question": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 2,
      "title": "Question"
     },
     "history": {
      "items": {
       "$ref": "#/components/schemas/ChatTurn"
      },
      "type": "array",
      "maxItems": 12,
      "title": "History"
     },
     "scan_id": {
      "anyOf": [
       {
        "type": "string",
        "format": "uuid"
       },
       {
        "type": "null"
       }
      ],
      "title": "Scan Id"
     }
    },
    "type": "object",
    "required": [
     "question"
    ],
    "title": "ChatIn"
   },
   "ChatTurn": {
    "properties": {
     "role": {
      "type": "string",
      "enum": [
       "user",
       "assistant"
      ],
      "title": "Role"
     },
     "content": {
      "type": "string",
      "maxLength": 4000,
      "title": "Content"
     }
    },
    "type": "object",
    "required": [
     "role",
     "content"
    ],
    "title": "ChatTurn"
   },
   "ClinicOut": {
    "properties": {
     "slug": {
      "type": "string",
      "title": "Slug"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "currency": {
      "type": "string",
      "title": "Currency"
     }
    },
    "type": "object",
    "required": [
     "slug",
     "name",
     "currency"
    ],
    "title": "ClinicOut"
   },
   "CostEstimate": {
    "properties": {
     "clinic": {
      "type": "string",
