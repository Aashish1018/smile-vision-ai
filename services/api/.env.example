ENV=development
DATABASE_URL=postgresql+asyncpg://smileos:smileos@localhost:5432/smileos
CORS_ORIGINS=["http://localhost:5173"]

# Auth: dev login for local demos; set SUPABASE_URL to verify Supabase-issued tokens (JWKS).
ALLOW_DEV_LOGIN=true
JWT_SECRET=change-me-to-a-long-random-string
# SUPABASE_URL=https://your-project.supabase.co

# Models: providers are tried in order. Any OpenAI-compatible endpoint works.
LLM_PROVIDERS=[{"name":"ollama","base_url":"http://localhost:11434/v1","chat_model":"gemma3:4b","vision_model":"gemma3:4b"}]
# Example hosted fallback (Groq free tier):
# LLM_PROVIDERS=[{"name":"ollama","base_url":"http://localhost:11434/v1","chat_model":"gemma3:4b","vision_model":"gemma3:4b"},{"name":"groq","base_url":"https://api.groq.com/openai/v1","api_key":"gsk_...","chat_model":"llama-3.3-70b-versatile","vision_model":"meta-llama/llama-4-scout-17b-16e-instruct"}]

# Tracing: any OTLP/HTTP collector (Jaeger, Langfuse, Honeycomb...)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
